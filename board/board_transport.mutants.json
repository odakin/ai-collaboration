{
  "_comment": "board_transport.py の木の組み立ての lock (同じ commit を読みに来たプロセスは 1 本目の組み立てを待つ・途中で止まった組み立ての残りを消す・待ちに期限・cache の blob の扱い) の試験 (test_board.py の TreeBuild) が、 直した箇所を 1 つずつ外した版でそれぞれ落ちるか (unittest の FAIL 行で読む)",
  "target": "board_transport.py",
  "run": "python3 test_board.py -v TreeBuild",
  "fail_marker": "FAIL: ",
  "pass_marker": "test_",
  "mutants": [
    {"name": "lock を取らない (取れたことにしない)",
     "pairs": [["fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB); held = True; break", "held = False; break"]],
     "expect_fail": ["test_readers_of_one_new_commit_build_its_tree_once", "test_a_build_removes_the_leftovers_of_builds_whose_process_is_gone", "test_a_reader_stops_waiting_for_a_held_build_lock_and_builds_alone"]},
    {"name": "lock を取った後に、 待っていた間に組み上がった木を見直さない",
     "pairs": [["            if (board / BASE_FILE).is_file(): return board       # built by the process this one waited for", "            pass"]],
     "expect_fail": ["test_readers_of_one_new_commit_build_its_tree_once"],
     "expect_pass": ["test_a_build_removes_the_leftovers_of_builds_whose_process_is_gone", "test_a_reader_stops_waiting_for_a_held_build_lock_and_builds_alone"]},
    {"name": "途中で止まった組み立ての残りを消さない",
     "pairs": [["            if held: _remove_leftovers(tree)", "            pass"]],
     "expect_fail": ["test_a_build_removes_the_leftovers_of_builds_whose_process_is_gone"],
     "expect_pass": ["test_readers_of_one_new_commit_build_its_tree_once", "test_a_reader_stops_waiting_for_a_held_build_lock_and_builds_alone"]},
    {"name": "lock を持たないプロセスも残りを消す",
     "pairs": [["            if held: _remove_leftovers(tree)", "            _remove_leftovers(tree)"]],
     "expect_fail": ["test_a_reader_stops_waiting_for_a_held_build_lock_and_builds_alone"],
     "expect_pass": ["test_a_build_removes_the_leftovers_of_builds_whose_process_is_gone", "test_readers_of_one_new_commit_build_its_tree_once"]},
    {"name": "生きている pid の組み立て中の木も消す",
     "pairs": [["        if pid > 0 and not _alive(pid): shutil.rmtree(d, ignore_errors=True)", "        if pid > 0: shutil.rmtree(d, ignore_errors=True)"]],
     "expect_fail": ["test_a_build_removes_the_leftovers_of_builds_whose_process_is_gone"],
     "expect_pass": ["test_readers_of_one_new_commit_build_its_tree_once", "test_a_reader_stops_waiting_for_a_held_build_lock_and_builds_alone"]},
    {"name": "lock の待ちに期限が無い (握ったままの持ち主に全員が待たされる)",
     "pairs": [["                if time.monotonic() >= deadline: break", "                pass"]],
     "expect_fail": ["test_a_reader_stops_waiting_for_a_held_build_lock_and_builds_alone", "test_a_wait_that_is_not_a_finite_number_falls_back_to_the_git_timeout"],
     "expect_pass": ["test_readers_of_one_new_commit_build_its_tree_once", "test_a_build_removes_the_leftovers_of_builds_whose_process_is_gone"]},
    {"name": "filesystem が lock を断っても期限まで待つ",
     "pairs": [["                if e.errno not in (errno.EWOULDBLOCK, errno.EAGAIN): break", "                pass"]],
     "expect_fail": ["test_a_lock_the_filesystem_refuses_is_not_waited_for"],
     "expect_pass": ["test_readers_of_one_new_commit_build_its_tree_once", "test_a_reader_stops_waiting_for_a_held_build_lock_and_builds_alone"]},
    {"name": "待ちの値の nan・inf を受け入れる (終わらない待ち)",
     "pairs": [["        if not math.isfinite(wait) or wait < 0: wait = float(GIT_TIMEOUT)   # nan / inf would wait forever", "        pass"]],
     "expect_fail": ["test_a_wait_that_is_not_a_finite_number_falls_back_to_the_git_timeout"],
     "expect_pass": ["test_a_reader_stops_waiting_for_a_held_build_lock_and_builds_alone", "test_readers_of_one_new_commit_build_its_tree_once"]},
    {"name": "組み立てが例外で止まった時に自分の一時の dir を消さない",
     "pairs": [["                shutil.rmtree(tmp, ignore_errors=True); raise   # a kill cannot be caught: those leftovers go in _remove_leftovers", "                raise"]],
     "expect_fail": ["test_a_failed_build_leaves_no_temporary_directory"],
     "expect_pass": ["test_readers_of_one_new_commit_build_its_tree_once", "test_a_first_build_links_each_event_to_the_blob_cache"]},
    {"name": "link の前に cache に無い blob を復号しない (写しで済ませる)",
     "pairs": [["            if not os.access(cached, os.R_OK): self.blob(sha, rel, blob)", "            pass"]],
     "expect_fail": ["test_a_first_build_links_each_event_to_the_blob_cache"],
     "expect_pass": ["test_readers_of_one_new_commit_build_its_tree_once", "test_a_failed_build_leaves_no_temporary_directory"]},
    {"name": "読めない cache の blob を在るだけで link する (復号し直さない)",
     "pairs": [["            if not os.access(cached, os.R_OK): self.blob(sha, rel, blob)", "            if not cached.is_file(): self.blob(sha, rel, blob)"]],
     "expect_fail": ["test_an_unreadable_cached_blob_is_decrypted_again"],
     "expect_pass": ["test_a_first_build_links_each_event_to_the_blob_cache", "test_readers_of_one_new_commit_build_its_tree_once"]}
  ]
}
